		"@sveltejs/kit": "^2.49.1",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@types/node": "^20.11.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.3.4",
		"typescript": "^5.9.3",
		"vite": "^6.0.0",
		"storybook": "^10.2.3",
